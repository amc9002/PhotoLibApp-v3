# Copy this file to .env and fill in the values you need.
# .env is gitignored - it never gets committed.

# Optional. Only required for the "Generate with AI" photo-description
# feature in the photo edit modal. Everything else works without it.
# Get a key at https://console.anthropic.com (see README for details).
ANTHROPIC_API_KEY=

# Optional. Set to false to disable the AI endpoint outright - e.g. if
# you're hosting a single shared instance for others and don't want your
# key used at all yet. Defaults to true.
AI_ENABLED=
